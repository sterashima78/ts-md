{
  "name": "@sterashima78/ts-md-core",
  "version": "0.4.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "postbuild": "ts-md-tsc -p tsconfig.json --emitDeclarationOnly --outDir dist",
    "typecheck": "ts-md-tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "satteri": "catalog:",
    "ts-morph": "catalog:"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "devDependencies": {
    "@sterashima78/ts-md-tsc": "catalog:",
    "@sterashima78/ts-md-unplugin": "catalog:"
  }
}
