{
  "name": "@sterashima78/ts-md-core",
  "version": "0.3.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "ts-md-tsc -p tsconfig.json --emitDeclarationOnly --outDir dist",
    "typecheck": "ts-md-tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "remark-parse": "11.0.0",
    "ts-morph": "28.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "devDependencies": {
    "@sterashima78/ts-md-tsc": "0.2.0",
    "@sterashima78/ts-md-unplugin": "0.4.0",
    "@types/mdast": "4.0.4"
  }
}
