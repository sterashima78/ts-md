{
  "name": "@sterashima78/ts-md-vscode",
  "version": "0.1.1",
  "main": "dist/extension.js",
  "types": "dist/extension.d.ts",
  "engines": {
    "vscode": "^1.85.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && ts-md-tsc -p tsconfig.json --emitDeclarationOnly --rootDir src --outDir dist && tsx scripts/postbuild.ts",
    "package": "tsx scripts/package.ts",
    "typecheck": "ts-md-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "download": "tsx scripts/download.ts"
  },
  "dependencies": {
    "@sterashima78/ts-md-ls-core": "workspace:*",
    "@volar/language-server": "catalog:",
    "@volar/language-service": "catalog:",
    "@volar/vscode": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "volar-service-typescript": "catalog:",
    "vscode-uri": "catalog:"
  },
  "devDependencies": {
    "@sterashima78/ts-md-tsc": "catalog:",
    "@types/vscode": "catalog:",
    "@vscode/test-electron": "catalog:",
    "@vscode/vsce": "catalog:",
    "vitest": "catalog:"
  },
  "activationEvents": [
    "onLanguage:ts-md"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ts-md",
        "aliases": [
          "TypeScript Markdown",
          "ts-md"
        ],
        "extensions": [
          ".ts.md"
        ],
        "filenamePatterns": [
          "*.ts.md"
        ],
        "configuration": "./dist/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ts-md",
        "scopeName": "source.tsmd",
        "path": "./dist/syntaxes/ts-md.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "tsmd.runTest",
        "title": "TS-MD: Run Test Chunk"
      },
      {
        "command": "tsmd.runChunk",
        "title": "TS-MD: Run Chunk"
      },
      {
        "command": "tsmd.tangle",
        "title": "TS-MD: Tangle to Files"
      }
    ]
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
