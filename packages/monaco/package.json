{
  "name": "@sterashima78/ts-md-monaco",
  "version": "0.1.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && ts-md-tsc -p tsconfig.json --emitDeclarationOnly --rootDir src --outDir dist",
    "typecheck": "ts-md-tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@monaco-editor/react": "catalog:",
    "@sterashima78/ts-md-ls-core": "workspace:*",
    "@volar/monaco": "catalog:",
    "monaco-editor": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@sterashima78/ts-md-tsc": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "jsdom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
