{
  "name": "@sterashima78/ts-md-unplugin",
  "version": "0.4.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./vite": "./dist/vite.js",
    "./rollup": "./dist/rollup.js",
    "./webpack": "./dist/webpack.js",
    "./esbuild": "./dist/esbuild.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "ts-md-tsc -p tsconfig.json --emitDeclarationOnly --outDir dist",
    "typecheck": "ts-md-tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rollup/pluginutils": "5.4.0",
    "@sterashima78/ts-md-core": "workspace:*",
    "rollup": "4.62.3",
    "unplugin": "3.3.0"
  },
  "devDependencies": {
    "@sterashima78/ts-md-tsc": "0.2.0",
    "ts-md-unplugin-build": "npm:@sterashima78/ts-md-unplugin@0.4.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
