{
  "name": "@sterashima78/ts-md-unplugin",
  "version": "0.4.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./vite": "./dist/vite.js",
    "./rollup": "./dist/rollup.js",
    "./rolldown": "./dist/rolldown.js",
    "./webpack": "./dist/webpack.js",
    "./esbuild": "./dist/esbuild.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "postbuild": "ts-md-tsc -p tsconfig.json --emitDeclarationOnly --outDir dist",
    "typecheck": "ts-md-tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sterashima78/ts-md-core": "workspace:*",
    "unplugin": "catalog:"
  },
  "devDependencies": {
    "@sterashima78/ts-md-tsc": "catalog:",
    "ts-md-unplugin-build": "catalog:"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
